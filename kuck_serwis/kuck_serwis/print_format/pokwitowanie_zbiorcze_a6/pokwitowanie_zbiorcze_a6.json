 "css": "\n.print-format { page-size: A6; margin-top: 4mm; margin-bottom: 4mm; margin-left: 4mm; margin-right: 4mm; }\n@media screen { .print-format { width: 105mm; max-width: 105mm; min-height: 148mm; padding: 4mm; margin: 12px auto; } }\n.pokwit { font-family: Arial, Helvetica, sans-serif; font-size: 8.5px; color:#111; width:100%; line-height:1.25; }\ntable.head { width:100%; border-collapse:collapse; border-bottom:1.5px solid #000; margin-bottom:4px; }\ntable.head td { vertical-align:top; padding-bottom:3px; }\n.brand img.logo { height:30px; margin-bottom:2px; }\n.brand .iss { font-size:11px; margin-top:1px; white-space:nowrap; }\n.brand .iss b { font-size:12px; }\ntd.meta { text-align:right; white-space:nowrap; padding-left:6px; }\ntd.meta .title { font-weight:bold; font-size:9px; }\ntable.kv { width:100%; border-collapse:collapse; margin:2px 0; }\ntable.kv td { padding:1px 2px; vertical-align:top; }\ntable.kv td.l { font-weight:bold; width:62px; white-space:nowrap; }\ntable.items { width:100%; border-collapse:collapse; margin:3px 0; }\ntable.items th, table.items td { border:1px solid #000; padding:2px 3px; vertical-align:top; font-size:8px; }\ntable.items th { background:#eee; text-align:left; }\ntable.items td.lp { width:14px; text-align:center; }\n.block { margin:2px 0; padding-left:2px; }\n.block .l { font-weight:bold; }\ntable.sign { width:100%; border-collapse:collapse; margin-top:18px; }\ntable.sign td { width:50%; text-align:center; font-size:7.5px; padding:0 8px; }\ntable.sign .line { border-top:1px solid #000; padding-top:2px; }\n.rodo { margin-top:6px; font-size:6.5px; color:#444; text-align:justify; border-top:1px dashed #999; padding-top:2px; }\n@media print { @page { size: 105mm 148mm; margin: 4mm; } }\n",
 "custom_format": 1,
 "default_print_language": "pl",
 "disabled": 0,
 "doc_type": "Przyjecie Zbiorcze",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<div class=\"pokwit\">\n  <table class=\"head\"><tr>\n    <td class=\"brand\">\n      <img class=\"logo\" src=\"data:image/png;base64,\" alt=\"KUCK\">\n      <div class=\"iss\">Nr przyjęcia: <b>{{ doc.name }}</b></div>\n    </td>\n    <td class=\"meta\">\n      <div class=\"title\">Pokwitowanie przyjęcia zbiorczego</div>\n      <div>Data: {{ frappe.utils.format_date(doc.creation, \"dd.MM.yyyy\") }}</div>\n      <div>Zegarków: {{ doc.pozycje | length }}</div>\n    </td>\n  </tr></table>\n\n  <table class=\"kv\">\n    <tr><td class=\"l\">Klient</td><td>{{ doc.klient_nazwa or doc.klient }}{% if doc.klient_telefon %}, tel. {{ doc.klient_telefon }}{% endif %}</td></tr>\n    <tr><td class=\"l\">Rodzaj</td><td>{{ doc.rodzaj_naprawy }}</td></tr>\n    <tr><td class=\"l\">Dostawa / odbiór</td><td>{{ doc.sposob_dostarczenia }} / {{ doc.sposob_odbioru }}</td></tr>\n    {% if doc.klient_zaakceptowal %}<tr><td class=\"l\">Akceptacja</td><td>Tak{% if doc.akceptacja_uwagi %} &middot; {{ doc.akceptacja_uwagi }}{% endif %}</td></tr>{% endif %}\n    {% if doc.orientacyjny_termin_naprawy %}<tr><td class=\"l\">Termin orient.</td><td>{{ frappe.utils.format_date(doc.orientacyjny_termin_naprawy, \"dd.MM.yyyy\") }}</td></tr>{% endif %}\n  </table>\n\n  <table class=\"items\">\n    <thead><tr><th class=\"lp\">#</th><th>Zegarek</th><th>Nr seryjny</th><th>Usterka / stan</th><th>Nr naprawy</th></tr></thead>\n    <tbody>\n    {% for p in doc.pozycje %}\n      <tr>\n        <td class=\"lp\">{{ loop.index }}</td>\n        <td>{{ p.marka or \"\" }} {{ p.model_zegarka or \"\" }}</td>\n        <td>{{ p.numer_seryjny or \"\" }}</td>\n        <td>{{ p.opis or \"\" }}{% if p.stan_przy_przyjeciu %}<br><i>{{ p.stan_przy_przyjeciu }}</i>{% endif %}</td>\n        <td>{{ p.naprawa or \"\" }}</td>\n      </tr>\n    {% endfor %}\n    </tbody>\n  </table>\n\n  <table class=\"sign\"><tr>\n    <td><div class=\"line\">Podpis klienta</div></td>\n    <td><div class=\"line\">Podpis przyjmującego</div></td>\n  </tr></table>\n  <div class=\"rodo\">\n    <b>Administrator danych osobowych:</b> KUCK ZEGARKI BIŻUTERIA SP. J., ul. 11 Listopada 8, 10-104 Olsztyn,\n    NIP 7393755821, tel. +48 734 470 478. Udostępnione w tym dokumencie dane osobowe będą wykorzystywane\n    wyłącznie do prawidłowej realizacji umowy. Pełna polityka prywatności dostępna jest na stronie: <b>www.kuck.pl</b>.\n  </div>\n</div>\n",
